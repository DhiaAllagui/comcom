# Copy this file to `.env` and fill in the real value.
# `.env` is gitignored — never commit the real key.

# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com — enter the inbox address that should
# receive enquiries and they email you the key. No account required.
#
# NOTE: Vite bakes VITE_* variables into the bundle at BUILD time, so `.env`
# must exist on whatever machine runs `npm run build`. Setting it on the server
# afterwards has no effect.
#
# If left empty, the contact form fails safe: it tells visitors to email or use
# WhatsApp instead of silently discarding their enquiry.
VITE_WEB3FORMS_KEY=
